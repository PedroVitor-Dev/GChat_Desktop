{
  "manifest_version": 3,
  "name": "GChat Desktop+",
  "version": "0.0.0",
  "description": "Encaminha as notificações do Google Chat para o app GChat Desktop+ no Windows.",
  "minimum_chrome_version": "111",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://chat.google.com/*"],
      "js": ["notification-hook.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["https://chat.google.com/*"],
      "js": ["content-bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
