{
  "name": "@gchat/desktop",
  "private": true,
  "version": "0.0.7",
  "description": "GChat Desktop+ — Google Chat para Windows com notificações e sons personalizáveis",
  "author": "Pedro Vitor",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.preload.json && tsc -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win --x64 --publish never",
    "icons": "electron scripts/generate-icons.cjs",
    "sounds": "node scripts/generate-sounds.mjs",
    "installer-art": "electron scripts/generate-installer-art.cjs",
    "appx-assets": "electron scripts/generate-appx-assets.cjs",
    "dist:store": "node scripts/dist-store.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.78.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  },
  "productName": "GChat Desktop+",
  "dependencies": {
    "@sapphi-red/web-noise-suppressor": "0.4.1",
    "electron-updater": "^6.8.11"
  }
}
